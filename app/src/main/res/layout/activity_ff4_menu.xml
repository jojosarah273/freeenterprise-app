<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- The status slot is ALWAYS present and always the same height (pinned in
         FF4MenuActivity), even when a screen has nothing to say. If it collapsed
         instead, the flexible menu box below would grow, and entering a screen
         showed it reshaping from the previous screen's size as the text arrived.
         INVISIBLE (not GONE) reserves the space without drawing an empty box. -->
    <com.freeenterprise.app.ff4ui.FF4Window
        android:id="@+id/ff4StatusWindow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible">

        <TextView
            android:id="@+id/ff4StatusText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF" />
    </com.freeenterprise.app.ff4ui.FF4Window>

    <com.freeenterprise.app.ff4ui.FF4Window
        android:id="@+id/ff4MenuWindow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <ScrollView
            android:id="@+id/ff4Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <com.freeenterprise.app.ff4ui.FF4Menu
                android:id="@+id/ff4Menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </com.freeenterprise.app.ff4ui.FF4Window>

    <com.freeenterprise.app.ff4ui.FF4Window
        android:id="@+id/ff4HintWindow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ff4Hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF" />

            <!-- small version indicator, far right of the hint box -->
            <TextView
                android:id="@+id/ff4Version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#9AA4B2" />
        </LinearLayout>
    </com.freeenterprise.app.ff4ui.FF4Window>

</LinearLayout>